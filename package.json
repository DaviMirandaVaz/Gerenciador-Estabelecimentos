{
  "name": "projeto2026",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "build:web": "expo export --platform web",
    "build:exe": "expo export --platform web && electron-builder --win"
  },
  "build": {
    "appId": "com.elyssabueno.projeto2026",
    "productName": "Projeto2026",
    "disableDefaultIgnoredFiles": true,
    "directories": {
      "output": "dist-desktop"
    },
    "artifactName": "Projeto2026-Portable-${arch}.${ext}",
    "files": [
      "package.json",
      "dist/**/*",
      "electron/**/*",
      "dist/assets/node_modules/**/*",
      "node_modules/expo-sqlite/web/wa-sqlite/**/*",
      "node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/**/*",
      "node_modules/@react-navigation/drawer/lib/module/views/assets/**/*"
    ],
    "asarUnpack": [
      "**/*.wasm",
      "**/*.ttf",
      "**/*.otf",
      "electron/**/*",
      "node_modules/@expo/vector-icons/**/*",
      "node_modules/@react-navigation/drawer/lib/module/views/assets/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "icon": "assets/images/icon.png",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "sign": null
    },
    "forceCodeSigning": false,
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/drawer": "^7.5.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.35",
    "expo-auth-session": "~7.0.11",
    "expo-camera": "~17.0.10",
    "expo-checkbox": "~5.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.3",
    "react-native-dropdown-picker": "^5.4.6",
    "react-native-dropdown-select-list": "^2.0.5",
    "react-native-element-dropdown": "^2.12.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-mmkv": "^4.3.1",
    "react-native-nitro-modules": "^0.35.3",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@react-native-community/cli": "latest",
    "@types/react": "~19.1.0",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
